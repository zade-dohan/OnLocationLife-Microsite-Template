[
  {
    "label": "Section ID (anchor)",
    "name": "section_id",
    "type": "text",
    "default": "ms-life-on-site"
  },
  {
    "label": "Background image",
    "name": "background_image",
    "type": "image",
    "default": {
      "src": "",
      "alt": "",
      "loading": "lazy"
    }
  },
  {
    "label": "Eyebrow",
    "name": "eyebrow",
    "type": "text",
    "default": "Lorem Ipsum"
  },
  {
    "label": "Heading",
    "name": "heading",
    "type": "text",
    "default": "Consectetur Adipiscing Elit"
  },
  {
    "label": "Intro text",
    "name": "intro",
    "type": "richtext",
    "enabled_features": ["standard_emphasis"],
    "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>"
  },
  {
    "label": "Amenities",
    "name": "items",
    "type": "group",
    "occurrence": {
      "min": 1,
      "max": 8,
      "default": 4,
      "sorting_label_field": "items.title"
    },
    "children": [
      {
        "label": "Icon",
        "name": "icon",
        "type": "choice",
        "display": "select",
        "choices": [
          ["bed", "Single occupancy / bed"],
          ["dining", "Dining"],
          ["transport", "Transportation"],
          ["shield", "Security / guest services"],
          ["custom", "Upload custom icon"]
        ],
        "default": "bed"
      },
      {
        "label": "Custom icon image",
        "name": "icon_image",
        "type": "image",
        "default": { "src": "", "alt": "", "loading": "lazy" },
        "visibility": {
          "controlling_field": "items.icon",
          "controlling_value_regex": "custom",
          "operator": "EQUAL"
        }
      },
      {
        "label": "Title",
        "name": "title",
        "type": "text",
        "default": "Amenity title"
      },
      {
        "label": "Description",
        "name": "text",
        "type": "text",
        "allow_new_line": true,
        "default": "Amenity description."
      }
    ],
    "default": [
      {
        "icon": "bed",
        "title": "Lorem Ipsum",
        "text": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt."
      },
      {
        "icon": "dining",
        "title": "Dolor Sit Amet",
        "text": "Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip."
      },
      {
        "icon": "transport",
        "title": "Consectetur Adipiscing",
        "text": "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore."
      },
      {
        "icon": "shield",
        "title": "Sed Do Eiusmod",
        "text": "Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt."
      }
    ]
  }
]
