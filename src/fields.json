      {
        "label": "Accent font (script / italic)",
        "name": "accent_font",
        "type": "choice",
        "display": "select",
        "choices": [
          ["Gelica", "Gelica (theme default)"],
          ["Georgia", "Georgia"],
          ["Arial", "Arial"]
        ],
        "default": "Gelica"
      },
      {
        "label": "Body font",
        "name": "body_font",
        "type": "choice",
        "display": "select",
        "choices": [
          ["Gotham", "Gotham (theme default)"],
          ["Arial", "Arial"],
          ["Georgia", "Georgia"]
        ],
        "default": "Gotham"
